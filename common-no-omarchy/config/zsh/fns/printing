# Print at real size (no scaling), one-sided, with printer selection
# Usage: printreal <file> [pages]   e.g. printreal patron.pdf 1-3,5
printreal() {
  [[ -z $1 ]] && { echo "Usage: printreal <file> [pages]"; return 1; }
  [[ -f $1 ]] || { echo "File not found: $1"; return 1; }

  local printer
  printer=$(lpstat -a | cut -d' ' -f1 | fzf \
    --height=~10 \
    --min-height=3 \
    --reverse \
    --no-border \
    --no-info \
    --no-separator \
    --prompt="Imprimante > " \
    --pointer="") || return

  local -a opts=(-o print-scaling=none -o sides=one-sided)
  [[ -n $2 ]] && opts+=(-o page-ranges="$2")

  lp -d "$printer" "${opts[@]}" "$1"
}
