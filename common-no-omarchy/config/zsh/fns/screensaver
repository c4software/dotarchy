# Loop random ttfx effects on random scenes, centred in the terminal (q, Esc or Ctrl+C to quit)
# Usage: screensaver [file|dir]   (default: ~/.config/zsh/screensavers/)
# Scenes are generated by ~/.config/zsh/screensavers/gen.py (edit it, then run python3 gen.py)
screensaver() {
  local src="${1:-$HOME/.config/zsh/screensavers}"
  local -a files
  if [[ -d $src ]]; then
    files=("$src"/*.txt(N))
  elif [[ -f $src ]]; then
    files=("$src")
  fi
  (( ${#files} )) || { echo "No scene found in: $src"; return 1; }

  # q, Esc or Ctrl+C quits; any other key skips the pause to the next scene.
  # The tty is put in -isig so Ctrl+C arrives as a \x03 byte, polled every 0.1 s:
  # exiting from a signal trap would leave zsh blocked in the pending read.
  (
    local stty_saved=$(stty -g) pid= last= file key quit=0 i
    _ss_key() {
      read -s -k1 -t 0.1 key || return 1
      [[ $key == [qQ] || $key == $'\e' || $key == $'\x03' ]] && quit=1
      return 0
    }
    trap 'quit=1' INT TERM HUP
    stty -echo -icanon -isig
    tput civis
    while (( ! quit )); do
      file=${files[RANDOM % ${#files} + 1]}
      (( ${#files} > 1 )) && [[ $file == $last ]] && continue
      last=$file
      clear
      ttfx -i "$file" \
        --canvas-width 0 --canvas-height 0 --reuse-canvas \
        --anchor-canvas c --anchor-text c --random-effect --no-eol </dev/null &
      pid=$!
      while (( ! quit )) && kill -0 $pid 2>/dev/null; do _ss_key; done
      if (( quit )); then
        kill $pid 2>/dev/null
        wait $pid 2>/dev/null
        break
      fi
      wait $pid || break
      for i in {1..30}; do (( quit )) && break; _ss_key && break; done
    done
    stty $stty_saved
    printf '\e[0m'
    tput cnorm
    clear
  )
}
