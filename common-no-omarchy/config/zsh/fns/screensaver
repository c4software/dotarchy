# Loop random ttfx effects on random scenes, centred in the terminal (q, Esc or Ctrl+C to quit)
# Usage: screensaver [file|dir]   (default: ~/.config/zsh/screensavers/)
# Scenes are generated by ~/.config/zsh/screensavers/gen.py (edit it, then run python3 gen.py)
screensaver() {
  local src="${1:-$HOME/.config/zsh/screensavers}"
  local -a files
  if [[ -d $src ]]; then
    files=("$src"/*.txt(N))
  elif [[ -f $src ]]; then
    files=("$src")
  fi
  (( ${#files} )) || { echo "No scene found in: $src"; return 1; }

  # q / Esc (or Ctrl+C) quits; any other key skips the pause to the next scene
  (
    local stty_saved=$(stty -g) pid= last= file key
    _ss_quit() {
      [[ -n $pid ]] && { kill $pid 2>/dev/null; wait $pid 2>/dev/null; }
      stty $stty_saved
      printf '\e[0m'
      tput cnorm
      clear
      exit 0
    }
    _ss_key() { read -s -k1 -t $1 key && [[ $key == [qQ] || $key == $'\e' ]] && _ss_quit; }
    trap _ss_quit INT TERM
    stty -echo -icanon
    tput civis
    while true; do
      file=${files[RANDOM % ${#files} + 1]}
      (( ${#files} > 1 )) && [[ $file == $last ]] && continue
      last=$file
      clear
      ttfx -i "$file" \
        --canvas-width 0 --canvas-height 0 --reuse-canvas \
        --anchor-canvas c --anchor-text c --random-effect --no-eol </dev/null &
      pid=$!
      while kill -0 $pid 2>/dev/null; do _ss_key 0.1; done
      wait $pid || break
      pid=
      _ss_key 3
    done
    _ss_quit
  )
}
