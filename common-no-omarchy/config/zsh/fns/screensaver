# Loop random ttfx effects on random scenes, centred in the terminal (Ctrl+C to quit)
# Usage: screensaver [file|dir]   (default: ~/.config/zsh/screensavers/)
# Scenes are generated by ~/.config/zsh/screensavers/gen.py (edit it, then run python3 gen.py)
screensaver() {
  local src="${1:-$HOME/.config/zsh/screensavers}"
  local -a files
  if [[ -d $src ]]; then
    files=("$src"/*.txt(N))
  elif [[ -f $src ]]; then
    files=("$src")
  fi
  (( ${#files} )) || { echo "No scene found in: $src"; return 1; }

  (
    trap 'tput cnorm; clear; exit 0' INT TERM
    tput civis
    clear
    local last= file
    while true; do
      file=${files[RANDOM % ${#files} + 1]}
      (( ${#files} > 1 )) && [[ $file == $last ]] && continue
      last=$file
      clear
      ttfx -i "$file" \
        --canvas-width 0 --canvas-height 0 --reuse-canvas \
        --anchor-canvas c --anchor-text c --random-effect --no-eol || break
      sleep 3
    done
    tput cnorm
    clear
  )
}
