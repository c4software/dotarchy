# Pick an Android emulator with gum and start it through the Android CLI, which
# returns once the device is ready (extra args go to android emulator start,
# e.g. android-emu --cold or android-emu --headless; stop: android emulator stop <avd>)
android-emu() {
  local avds avd

  avds="$(android emulator list 2>/dev/null)"
  if [[ -z "$avds" ]]; then
    echo "No emulator found"
    return 1
  fi

  avd="$(echo "$avds" | gum choose --header "Launch emulator")" || return

  android emulator start "$@" "$avd"
}
