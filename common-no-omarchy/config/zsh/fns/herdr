# The agents typed in a shell run in a terminal of herdr-core, attached to
# it (~/.config/tmux/herdr here), in tmux or not: herdr-app shows them, and
# in tmux the sidebar shows their status and the notifications say when they
# need you. Nothing else changes: same program, same terminal, same keys
# (Ctrl+\ detaches, the agent keeps running in herdr-core). Without
# herdr-core, not interactive (a pipe) or a one-shot mode (-p, --help...),
# the program runs as before. `command claude` skips it.
for _herdr_agent in claude codex pi omp opencode; do
  eval "
    $_herdr_agent() {
      if [[ -x ~/.config/tmux/herdr && -t 0 && -t 1 ]] && (( \$+commands[herdr-core] )); then
        ~/.config/tmux/herdr here $_herdr_agent \"\$@\"
      else
        command $_herdr_agent \"\$@\"
      fi
    }"
done
unset _herdr_agent
