# File system
if command -v eza &> /dev/null; then
  alias ls='eza -lh --group-directories-first --icons=auto'
  alias ll='ls -lh'
  alias lsa='ls -a'
  alias lt='eza --tree --level=2 --long --icons --git'
  alias lta='lt -a'
fi

if [[ "$TERM" == "xterm-kitty" ]]; then
  alias ff="fzf --preview 'case \$(file --mime-type -b {}) in image/*) kitty icat --clear --transfer-mode=memory --stdin=no --place=\${FZF_PREVIEW_COLUMNS}x\${FZF_PREVIEW_LINES}@0x0 {} ;; *) bat --style=numbers --color=always {} ;; esac'"
else
  alias ff="fzf --preview 'bat --style=numbers --color=always {}'"
fi
alias eff='$EDITOR "$(ff)"'
sff() {
  if [ $# -eq 0 ]; then
    echo "Usage: sff <destination> (e.g. sff host:/tmp/)"
    return 1
  fi
  local file
  file=$(find . -type f -printf '%T@\t%p\n' | sort -rn | cut -f2- | ff) \
    && [ -n "$file" ] && scp "$file" "$1"
}

open() (
  xdg-open "$@" >/dev/null 2>&1 &
)

# Directories
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# Tools
alias g='git'
alias d='docker'
alias a='omarchy-agent --inline'
alias c='opencode --auto'
alias cx='printf "\033[2J\033[3J\033[H" && claude --permission-mode bypassPermissions'
alias cy='codex -s danger-full-access -a never'
alias r='rails'
alias h='herdr'
alias ic='tdl c'
alias ix='tdl cx'
alias icx='tdl c cx'
n() { if [ "$#" -eq 0 ]; then nvim .; else nvim "$@"; fi; }

# Git
alias gcm='git commit -m'
alias gcam='git commit -a -m'
alias gcad='git commit -a --amend'

alias apk="adb install -r"
alias logcat="adb logcat"
alias todaystory="git log --pretty=format:'- %s' --after='yesterday'"
alias yesterdaystory="git log --pretty=format:'- %s' --since=yesterday --before=0am"
alias git-no-sign="git -c commit.gpgsign=false"
alias git-last-tag="git describe --tags --abbrev=0"
alias serve-php='php -S localhost:9000'
alias openLinkAndroid='adb shell am start -a android.intent.action.VIEW -d'
alias spotdl='docker run --rm -v "$(pwd):/music" spotdl/spotify-downloader --output "{artist}/{album}/{track-number} - {title}.{output-ext}" download'
alias ytdl='docker run --rm -v .:/downloads -it jauderho/yt-dlp:latest -x --audio-format mp3 --audio-quality 0 --embed-metadata -o "%(uploader)s/%(title)s [%(id)s].%(ext)s"'
alias repo='open "$(git remote get-url origin | sed -E "s#git@([^:]+):#https://\1/#; s#\.git\$##")"'
alias vim='nvim'
alias t='tmux attach || tmux new-session -s Work /bin/zsh'
alias p='proj'
alias claude-local="ANTHROPIC_BASE_URL=http://bigchuck:8009 ANTHROPIC_AUTH_TOKEN=valentin ANTHROPIC_DEFAULT_OPUS_MODEL=qwopus3.6-27b-coder-mtp-nothink ANTHROPIC_DEFAULT_SONNET_MODEL=qwen3.6-35b-a3b-nothink ANTHROPIC_DEFAULT_HAIKU_MODEL=qwen3.5-9b API_TIMEOUT_MS=3000000 CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 claude --model qwen3.6-35b-a3b-nothink"

