# Editor used by CLI
export EDITOR="nvim"
export SUDO_EDITOR="$EDITOR"
export BAT_THEME=ansi
# Garder un agent déjà présent (ForwardAgent via OpenSSH ou Tailscale SSH)
[ -S "$SSH_AUTH_SOCK" ] || export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/ssh-agent.socket"
export BROWSER="${BROWSER:-omarchy-launch-browser}"
# Key of llm-proxy (account key in ~/.config/llm-proxy.key, mode 600, not
# versioned), for the llm-proxy.ts extension and the mcp.json of pi and omp,
# and Codex (env_key, bearer_token_env_var). pi and Codex refuse an unset
# variable: "unused" is enough for an open proxy. gufo-media.ts reads
# LLM_PROXY_KEY.
[ -r ~/.config/llm-proxy.key ] && export LLM_PROXY_API_KEY="$(<~/.config/llm-proxy.key)"
export LLM_PROXY_API_KEY="${LLM_PROXY_API_KEY:-unused}"
export LLM_PROXY_KEY="$LLM_PROXY_API_KEY"

export MANROFFOPT="-c"
export MANPAGER="sh -c 'col -bx | bat -l man -p'"

if [ -z "${LANG:-}" ]; then
  [ -r /etc/locale.conf ] && . /etc/locale.conf
  LANG="${LANG:-C.UTF-8}"
  export LANG LANGUAGE LC_CTYPE LC_NUMERIC LC_TIME LC_COLLATE LC_MONETARY \
    LC_MESSAGES LC_PAPER LC_NAME LC_ADDRESS LC_TELEPHONE LC_MEASUREMENT \
    LC_IDENTIFICATION
fi

[ -r /usr/share/omarchy/default/bash/env-bootstrap ] && . /usr/share/omarchy/default/bash/env-bootstrap
