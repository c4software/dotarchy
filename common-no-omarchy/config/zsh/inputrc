# Key bindings for zsh
bindkey -e  # Emacs mode

# History search with arrow keys (must be after bindkey -e)
autoload -U history-search-end
zle -N history-beginning-search-backward-end history-search-end
zle -N history-beginning-search-forward-end history-search-end
bindkey "^[[A" history-beginning-search-backward-end
bindkey "^[[B" history-beginning-search-forward-end

bindkey "^[[1;5C" forward-word
bindkey "^[[1;5D" backward-word

# Completion settings
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' # Case insensitive
zstyle ':completion:*' menu select # Menu selection
zstyle ':completion:*' list-colors "${(@s.:.)LS_COLORS}" # Colored completion
zstyle ':completion:*' special-dirs true # Complete . and ..
zstyle ':completion:*' file-list all # Show file information
zstyle ':completion:*' accept-exact-dirs true # Don't complete already exact dirs
zstyle ':completion:*' group-name '' # Don't group completion results
