#!/usr/bin/env bash
# The terminals of herdr-core in tmux windows. herdr-core runs the terminals
# of herdr-app (the Herdr desktop app), on this machine or on one added to it
# as an SSH machine (herdr-app installs herdr-core in ~/.local/bin there).
# They outlive the app, so they can be reached from any SSH client, a phone
# included. Used by herdr.conf, next to this file.
#
#   herdr                 in tmux: the menu; outside: the picker of herdr-core
#   herdr popup           the agents in a floating window (tmux display-popup,
#                         fzf): the ones that need you first, the screen of the
#                         selected one beside; refreshed every 2 seconds. Its
#                         first line (or ctrl-n) starts a new agent
#   herdr sidebar toggle  a pane on the right, the height of the window, that
#                         lists the agents like the Agents panel of herdr-app
#                         (grouped by machine, status, age); one per window,
#                         made when the window is shown. herdr sidebar: what
#                         runs in it
#   herdr here <prog> [a] run an agent typed in a tmux pane in herdr-core,
#                         attached to the pane (the zsh functions of fns/herdr)
#   herdr adopt <t>       show terminal <t>, started without Herdr, in
#                         herdr-app too (a space for its folder, a tab)
#   herdr new             start an agent: which one and on which machine (this
#                         one or one of herdr-core), its folder (with the
#                         project picker of p there, or ctrl-o: the current
#                         one), then start it and open it in a tmux window. herdr-app shows it
#                         too: a space for its folder, a tab for it. The agents offered are
#                         the ones installed among HERDR_AGENTS (the tmux
#                         option @herdr_agents): claude codex pi omp opencode
#   herdr watch [socket]  follows herdr-core and, when an agent asks for an
#                         action (status blocked), shows a message on every
#                         tmux client and the count in @herdr_blocked (the ⚠
#                         of the agents button); one per tmux server, started
#                         by herdr.conf. watch restart: after an update
#   herdr menu [client]   the tmux menu of the agents, one line each: picking a
#                         line opens the agent in a window of its own, picking
#                         it again closes that window
#   herdr prepare [mouse] the same menu as a tmux command, in the option
#                         @herdr_menu, for herdr.conf (prefix + Alt+a, formerly the
#                         agents button); with mouse, it opens under the status line
#                         on the right, where the button is
#   herdr toggle <t>      open or close the window of terminal <t> (t7)
#   herdr open|close <t>  open (or go to) the window of terminal <t>, close it
#   herdr list            the live terminals, and whether a window is open
#   herdr has             1 when herdr-core is here (the agents button shows)
#   herdr count           the number of live terminals, nothing when there are
#                         none or herdr-core is missing (the agents button)
#
# Closing a window only detaches tmux from the terminal: the agent keeps
# running in herdr-core, and herdr-app still shows it. Ctrl+\ inside the
# window detaches too.
set -euo pipefail

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"

HC=""
if [ -x "$HOME/.local/bin/herdr-core" ]; then
  HC="$HOME/.local/bin/herdr-core"
elif command -v herdr-core >/dev/null 2>&1; then
  HC="$(command -v herdr-core)"
fi

# Stops when herdr-core is missing. From tmux the message goes to the status
# line, and the exit code stays 0: prefix + a runs through run-shell, which
# shows any output, or a non-zero exit code, in a pane view to close with q.
need_hc() {
  [ -n "$HC" ] && return 0
  if [ -n "${TMUX:-}" ] && tmux display-message \
      "herdr-core not available: herdr-app installs it on the machines it uses" 2>/dev/null; then
    exit 0
  fi
  echo "herdr-core not available on this machine." >&2
  echo "  herdr-app installs it on the machines it uses (herdr-core machine add)." >&2
  exit 1
}

# Live terminals of herdr-core, one per line: address, agent, where, status.
terminals() {
  "$HC" ls | jq -r '.terminals[]
    # No empty field (read joins the tabs around one)
    | [.address, (.agent // "shell"),
       (.where // .cwd // "?" | if . == "" then "?" else . end),
       (.status // "none" | if . == "" then "none" else . end)]
    | @tsv'
}

# Every terminal with all its fields (status_ms, labels...), one JSON per
# line: hc ls prints a summary only.
full() {
  printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"hello","params":{}}' \
    '{"jsonrpc":"2.0","id":2,"method":"terminal.list","params":{}}' \
    | timeout 5 "$HC" connect 2>/dev/null \
    | jq -c 'select(.id == 2) | .result.terminals[]'
}

# The tmux pane that shows terminal $1, tagged with the option @hc: of its
# window (opened by herdr open) or of the pane itself (herdr here).
find_window() {
  tmux list-panes -a -F '#{pane_id} #{@hc}' 2>/dev/null \
    | awk -v t="$1" '$2 == t { print $1; exit }' || true
}

check_addr() {
  [[ "$1" =~ ^[A-Za-z0-9_/-]+$ ]] || { echo "not a terminal address: $1" >&2; exit 2; }
}

# Opens the window of terminal $1, or goes to it when it is open already.
open_t() {
  local t="$1" name win
  check_addr "$t"
  win="$(find_window "$t")"
  if [ -n "$win" ]; then
    tmux switch-client ${HERDR_CLIENT:+-c "$HERDR_CLIENT"} -t "$(tmux display-message -p -t "$win" '#{session_id}')" \; select-window -t "$win" \; select-pane -t "$win"
    return 0
  fi
  # Named like the sidebar shows it: agent·space, @machine when not here
  # (claude·llm-proxy@dev-box)
  name="$(full | jq -r --arg t "$t" 'select(.address == $t and .state == "live")
    | [ (.status.app // .foreground.name // .argv[0] // "shell" | sub("-code$"; "")),
        ((.labels.where // "" | split(" / ") | first) // ""),
        (.cwd // "") ] | map(if . == "" then "-" else . end) | @tsv' | head -1 || true)"
  [ -n "$name" ] || { tmux display-message "No live Herdr terminal $t"; exit 0; }
  local app space cwd
  IFS=$'\t' read -r app space cwd <<<"$name"
  [ "$cwd" = - ] && cwd=""
  { [ -n "$space" ] && [ "$space" != - ]; } || space="$(basename "${cwd:-?}")"
  name="$app·$space"
  [[ "$t" == */* ]] && name="$name@${t%%/*}"
  name="${name//#/##}"
  # In the session of the client that asked (a click in a sidebar)
  local -a where=()
  local sess
  if [ -n "${HERDR_CLIENT:-}" ]; then
    # (display -p -c does not give the session of that client)
    sess="$(tmux list-clients -F '#{client_name} #{session_id}' | awk -v c="$HERDR_CLIENT" '$1 == c { print $2 }')"
    [ -n "$sess" ] && where=(-t "$sess:")
  fi
  win="$(tmux new-window "${where[@]}" -P -F '#{window_id}' -n "$name" "$HC attach $t")"
  tmux set-option -w -t "$win" @hc "$t"
}

# Only a window opened by herdr open: a pane of herdr here is yours.
close_t() {
  local win
  check_addr "$1"
  win="$(find_window "$1")"
  [ -n "$win" ] || return 0
  [ -n "$(tmux show -pqv -t "$win" @hc)" ] && return 0
  tmux kill-window -t "$win"
}

toggle() {
  check_addr "$1"
  if [ -n "$(find_window "$1")" ]; then close_t "$1"; else open_t "$1"; fi
}

# The lines of the menu, three words each (label, key, command), in ITEMS.
# Returns 1 when there is no live terminal.
ITEMS=()
build_items() {
  local n=0 key mark label addr agent where status
  ITEMS=()
  while IFS=$'\t' read -r addr agent where status; do
    [ -n "$addr" ] || continue
    n=$((n + 1))
    key=""
    [ "$n" -le 9 ] && key="$n"
    mark="○"
    [ -n "$(find_window "$addr")" ] && mark="●"
    # A # in a label would be read as a tmux format
    label="$mark $agent · $where ($status)"
    [ "$status" = blocked ] && label="$mark ⚠ $agent · $where (needs you)"
    ITEMS+=("${label//#/##}" "$key" "run-shell '$SELF toggle $addr'")
  done < <(terminals)
  [ "$n" -gt 0 ]
}

TITLE='#[align=centre] Herdr agents (● open) '

menu() {
  local client="${1:-}"
  local -a target=()
  [ -n "$client" ] && target=(-c "$client")
  if ! build_items; then
    tmux display-message "${target[@]}" "No live Herdr terminal"
    return 0
  fi
  tmux display-menu "${target[@]}" -T "$TITLE" -x C -y C "${ITEMS[@]}"
}

# One word of a tmux command, in double quotes.
tmux_word() {
  local w="${1//\\/\\\\}"
  w="${w//\"/\\\"}"
  w="${w//\$/\\\$}"
  printf '"%s"' "$w"
}

# The menu as a tmux command in @herdr_menu, for herdr.conf to run with
# run-shell -C. tmux only lets the mouse pick a line in a menu that the key
# binding of the click opens itself, with the click as its event; a menu that
# a shell opens through tmux display-menu takes the keyboard only.
prepare() {
  local from="${1:-}" cmd w
  local -a place=(-x C -y C)
  # From the button: under the status line, on the right where the button is
  [ "$from" = mouse ] && place=(-x R -y S)
  if [ -z "$HC" ]; then
    cmd="display-message $(tmux_word "herdr-core not available: herdr-app installs it on the machines it uses")"
  elif ! build_items; then
    cmd="display-message $(tmux_word "No live Herdr terminal")"
  else
    cmd="display-menu -T $(tmux_word "$TITLE") ${place[*]}"
    for w in "${ITEMS[@]}"; do cmd+=" $(tmux_word "$w")"; done
  fi
  tmux set -g @herdr_menu "$cmd"
}

# --- Floating window ------------------------------------------------------

# Rank of a status: the agents that need you first.
rank() {
  case "$1" in
    blocked) echo 0 ;; error) echo 1 ;; done) echo 2 ;; working) echo 3 ;;
    idle) echo 4 ;; *) echo 5 ;;
  esac
}

# The lines of the popup: address, tab, then what fzf shows (in colour).
lines() {
  local addr agent where status mark word colour
  [ -n "$HC" ] || return 0
  printf 'new\t\033[1;32m+ new agent\033[0m\n'
  while IFS=$'\t' read -r addr agent where status; do
    [ -n "$addr" ] || continue
    mark="○"
    [ -n "$(find_window "$addr")" ] && mark="●"
    case "$status" in
      blocked) colour='1;31' word='⚠ needs you' ;;
      error)   colour='31'   word='✗ error' ;;
      done)    colour='33'   word='✓ done' ;;
      working) colour='34'   word='… working' ;;
      idle)    colour='2'    word='idle' ;;
      *)       colour='2'    word='shell' ;;
    esac
    printf '%s\t%s\t%s \033[%sm%-12s\033[0m %-12s %s\n' \
      "$(rank "$status")" "$addr" "$mark" "$colour" "$word" "$agent" "$where"
  done < <(terminals 2>/dev/null) | sort -t $'\t' -k1,1n -s | cut -f2-
  return 0
}

# Runs inside the popup (herdr.conf opens it with display-popup -E).
popup() {
  if [ -z "$HC" ]; then
    echo "herdr-core not available: herdr-app installs it on the machines it uses"
    read -rsn1 -t 5 || true
    return 0
  fi
  SHELL=/bin/bash exec fzf --ansi --no-sort --track --id-nth=1 \
    --delimiter=$'\t' --with-nth=2 --listen \
    --layout=reverse --border=none --info=inline-right --prompt='agent › ' \
    --header='enter: open · ctrl-n: new agent · ctrl-x: close its window · ctrl-r: refresh · esc' \
    --preview="[ {1} = new ] && echo 'Start an agent here or on another machine.' || $HC read {1} 2>/dev/null | tail -n \$FZF_PREVIEW_LINES" \
    --preview-window='right,60%,border-left,<110(down,55%,border-top)' \
    --bind "start:reload-sync($SELF lines)+execute-silent($SELF tick \$FZF_PORT lines </dev/null >/dev/null 2>&1 &)" \
    --bind "ctrl-r:reload-sync($SELF lines)+refresh-preview" \
    --bind "enter:transform:[ {1} = new ] && echo 'become($SELF new)' || echo 'execute-silent($SELF open {1})+abort'" \
    --bind "ctrl-n:become($SELF new)" \
    --bind "ctrl-x:execute-silent([ {1} = new ] || $SELF close {1})+reload-sync($SELF lines)" \
    < /dev/null
}

# Refreshes a list every 2 seconds through the fzf API, until fzf ends:
# $2 is the command of this script that prints it (lines, side-lines).
tick() {
  local port="$1" what="${2:-lines}" extra=""
  [[ "$port" =~ ^[0-9]+$ ]] || exit 0
  [ "$what" = lines ] && extra="+refresh-preview"
  local last now fails=0
  last="$(date +%s)"
  [ "$what" = side-lines ] && [ -n "${TMUX_PANE:-}" ] && tmux set -p -t "$TMUX_PANE" @herdr_side_port "$port"
  while sleep 2; do
    now="$(date +%s)"
    # Another fzf in this pane since (it started again): this tick ends
    if [ "$what" = side-lines ] && [ -n "${TMUX_PANE:-}" ] \
      && [ "$(tmux show -pqv -t "$TMUX_PANE" @herdr_side_port 2>/dev/null)" != "$port" ]; then
      exit 0
    fi
    # Two seconds that lasted much longer: the machine slept. The sidebar can
    # come back from it stuck (no answer, odd characters): it starts again,
    # same pane, which ends this tick too (fzf starts a new one).
    if [ "$what" = side-lines ] && [ $(( now - last )) -gt 30 ] && [ -n "${TMUX_PANE:-}" ]; then
      side_log "tick: woke up after $(( now - last )) s, sidebar $TMUX_PANE started again"
      tmux respawn-pane -k -t "$TMUX_PANE" "$SELF sidebar"
      exit 0
    fi
    last="$now"
    if [ "$what" = side-lines ] && [ -n "${TMUX_PANE:-}" ]; then
      # A sidebar off screen does not ask herdr-core: it is refreshed when its
      # window is shown again (herdr sidebar ensure)
      [ "$(tmux display -p -t "$TMUX_PANE" '#{&&:#{window_active},#{session_attached}}' 2>/dev/null)" = 1 ] || continue
    fi
    # fzf gone (its port closed): this tick ends. One slow answer is not
    # enough, after a wake-up herdr-core can take a few seconds.
    if curl -fsS -m 2 -XPOST "localhost:$port" \
      -d "reload-sync($SELF $what)$extra" >/dev/null 2>&1; then
      fails=0
    else
      fails=$(( fails + 1 ))
      [ "$fails" -ge 3 ] && exit 0
      continue
    fi
    [ "$what" = side-lines ] && side_heal
  done
}

# --- New agent ------------------------------------------------------------

AGENTS="${HERDR_AGENTS:-$(tmux show -gqv @herdr_agents 2>/dev/null || true)}"
AGENTS="${AGENTS:-claude codex pi omp opencode}"

# The agents to offer, one per line: machine (. here: read with a tab as
# separator skips an empty first field), agent, label.
choices() {
  local a m found
  for a in $AGENTS; do
    command -v "$a" >/dev/null 2>&1 && printf '.\t%s\t%-10s here (%s)\n' "$a" "$a" "$(uname -n)"
  done
  printf '.\tshell\t%-10s here (%s)\n' shell "$(uname -n)"
  while read -r m; do
    [ -n "$m" ] || continue
    found="$("$HC" exec --on "$m" --timeout 5 \
      "for a in $AGENTS; do command -v \$a >/dev/null 2>&1 && echo \$a; done" 2>/dev/null)" || continue
    for a in $found; do printf '%s\t%s\t%-10s on %s\n' "$m" "$a" "$a" "$m"; done
    printf '%s\tshell\t%-10s on %s\n' "$m" shell "$m"
  done < <("$HC" machine ls 2>/dev/null | jq -r '.machines[] | select(.state == "connected") | .name')
}

# The herdr-app labels of a new terminal on machine $1 ("" here) in folder
# $2, in SPACE, TAB and SPACE_NEW (1 when herdr-app has no space for it yet,
# to name it). The space is the one herdr-app already has for that folder,
# else one of our own with an id made from the machine and the folder, so
# that the next agents there join it. Ids are local to the machine.
APP_JSON=""
app_labels() {
  local m="$1" dir="$2" own found
  own="sp$(printf '%s' "$m:$dir" | md5sum | cut -c1-32)"
  TAB="tb$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"
  SPACE="$own" SPACE_NEW=1
  command -v herdr-app >/dev/null 2>&1 || return 0
  APP_JSON="$(timeout 3 herdr-app ls 2>/dev/null)" || { APP_JSON=""; return 0; }
  found="$(jq -r --arg m "$m" --arg d "$dir" --arg b "$(basename "$dir")" --arg own "$own" '
    [.spaces[] | select((.machine // "") == $m)] as $s
    | (first($s[] | select((.id | split("/") | last) == $own))
       // first($s[] | select(.folder == $d and $d != ""))
       // first($s[] | select(.name == $b))
       // {}) | .id // empty' <<<"$APP_JSON" 2>/dev/null || true)"
  if [ -n "$found" ]; then SPACE="${found##*/}"; SPACE_NEW=""; fi
}

# Names the tab (the agent) and a new space (its folder) in herdr-app, when
# it runs here. It sees the terminal within a second or so.
app_names() {
  local m="$1" dir="$2" a="$3" TAB="$4" SPACE="$5" SPACE_NEW="${6:-}" pre="" i name
  [ -n "$m" ] && pre="$m/"
  name="$(basename "$dir")"
  [ "$dir" = "$HOME" ] && name="~"
  for i in 1 2 3 4 5 6; do
    herdr-app do tab.rename --id "$pre$TAB" --name "$a" >/dev/null 2>&1 && break
    sleep 0.5
  done
  [ -z "$SPACE_NEW" ] || herdr-app do space.rename --id "$pre$SPACE" --name "$name" >/dev/null 2>&1 || true
}

# Starts argv ($4...) on machine $1 in folder $2 with the herdr-app labels,
# its name in herdr-app $3. Prints what hc run printed (JSON).
start() {
  local m="$1" dir="$2" a="$3" out
  shift 3
  local -a on=()
  [ -n "$m" ] && on=(--on "$m")
  app_labels "$m" "$dir"
  out="$("$HC" run --bg --json --keep "${on[@]}" --cwd "$dir" \
    --label "herdr.space=$SPACE" --label "herdr.tab=$TAB" \
    --label "where=$( [ "$dir" = "$HOME" ] && echo '~' || basename "$dir") / $a" \
    ${1:+-- "$@"} 2>&1)" || true
  # A herdr-core updated while it ran keeps its old holder and starts
  # nothing ("holder build ... differs"): a restart fixes it, done here
  # when that core runs no terminal
  if [ -z "$m" ] && grep -q 'differs from core build' <<<"$out" \
      && [ "$("$HC" server status 2>/dev/null | jq -r '.live // 1')" = 0 ]; then
    # Without the variables of an agent that would run this: the terminals
    # of the core inherit its environment (a claude started there would take
    # itself for a sub-session of that agent)
    env $(env | sed -n 's/^\(CLAUDE[A-Z_]*\|CLAUDECODE\|AI_AGENT[A-Z_]*\)=.*/-u \1/p') \
      "$HC" server restart >/dev/null 2>&1 || true
    sleep 1
    out="$("$HC" run --bg --json --keep --cwd "$dir" \
      --label "herdr.space=$SPACE" --label "herdr.tab=$TAB" \
      --label "where=$(basename "$dir") / $a" ${1:+-- "$@"} 2>&1)" || true
  fi
  printf '%s\n' "$out"
  # In its own session: the popup that started it may close first
  if [ -n "$APP_JSON" ] && jq -e '.address' <<<"$out" >/dev/null 2>&1; then
    setsid -f "$SELF" app-names "$m" "$dir" "$a" "$TAB" "$SPACE" "$SPACE_NEW" </dev/null >/dev/null 2>&1
  fi
  return 0
}

# The project picker of p (~/.local/bin/proj, the script behind the alias
# p -> proj) on machine $1, its own UI: it prints the folder picked (enter)
# or made (ctrl-n, a git URL typed clones). Here it runs in this terminal;
# on another machine in a terminal of herdr-core there, attached here for
# the time of the pick, its answer kept in a file (ssh -t does not do: a box
# reached through a container has no /dev/tty for it). Returns 1 when
# nothing is picked, 2 when p is not there.
proj_pick() {
  local m="$1" t f out
  if [ -z "$m" ]; then
    [ -x "$HOME/.local/bin/proj" ] || return 2
    out="$(bash "$HOME/.local/bin/proj")" || return 1
  else
    "$HC" exec --on "$m" '[ -x ~/.local/bin/proj ]' >/dev/null 2>&1 || return 2
    f="/tmp/herdr-proj-$$-$RANDOM"
    t="$("$HC" run --bg --json --rm --no-parent --on "$m" \
      -- bash -c "bash ~/.local/bin/proj > $f" 2>/dev/null | jq -r '.address // empty')"
    [ -n "$t" ] || return 2
    "$HC" attach "$t" </dev/tty >/dev/tty 2>&1 || true
    out="$("$HC" exec --on "$m" "cat $f 2>/dev/null; rm -f $f" 2>/dev/null)" || true
  fi
  out="$(printf '%s\n' "$out" | tail -1)"
  [ -n "$out" ] || return 1
  printf '%s\n' "$out"
}

# The folder of the new agent on machine $1 (home $2): the one of p, or $3
# (the current one) when the agent was picked with ctrl-o or p is not
# there, to change by hand then. Prints it.
pick_folder() {
  local m="$1" home="$2" cur="$3" here="$4" name rc=0
  if [ -z "$here" ]; then
    proj_pick "$m" || rc=$?
    [ "$rc" = 2 ] || return "$rc"
  fi
  browse_folder "$m" "$home" "$cur"
}

# The folders in folder $2, on machine $1 (here when empty): one per line,
# hidden ones last
list_dirs() {
  local m="$1" d="$2" cmd
  cmd='cd "$1" 2>/dev/null || exit 0; for f in */ .[!.]*/; do [ -d "$f" ] && printf "%s\n" "${f%/}"; done; true'
  if [ -z "$m" ]; then
    bash -c "$cmd" _ "$d"
  else
    "$HC" exec --on "$m" --timeout 5 "bash -c '$cmd' _ $(printf '%q' "$d")" 2>/dev/null || true
  fi
}

# A folder picked by walking the tree (instead of typing it), on machine $1,
# from $3: enter goes in, .. up, . or ctrl-o takes it, ctrl-h goes home;
# typing filters the folders of the one shown.
browse_folder() {
  local m="$1" home="$2" dir="${3:-$2}" out key sel
  while :; do
    out="$( { printf '.\t\033[1;32m.\033[0m  use %s\n' "${dir/#$home/\~}"
              [ "$dir" != / ] && printf '..\t\033[2m..\033[0m\n'
              list_dirs "$m" "$dir" | while IFS= read -r f; do printf '%s\t%s/\n' "$f" "$f"; done
            } | fzf --ansi --delimiter=$'\t' --with-nth=2 --layout=reverse --gutter=' ' \
                  --no-sort --expect=ctrl-o,ctrl-h --no-preview \
                  --prompt="${dir/#$home/\~}/ › " \
                  --header="Folder${m:+ on $m} · enter: go in · . or ctrl-o: use it · ctrl-h: home · esc: cancel")" \
      || return 1
    key="$(head -1 <<<"$out")"
    sel="$(sed -n 2p <<<"$out")"; sel="${sel%%$'\t'*}"
    case "$key" in
      ctrl-h) dir="$home"; continue ;;
      ctrl-o)
        case "$sel" in .|"") ;; ..) dir="$(dirname "$dir")" ;; *) dir="${dir%/}/$sel" ;; esac
        printf '%s\n' "$dir"; return 0 ;;
    esac
    case "$sel" in
      .) printf '%s\n' "$dir"; return 0 ;;
      ..) dir="$(dirname "$dir")" ;;
      "") ;;
      *) dir="${dir%/}/$sel" ;;
    esac
  done
}

# Runs in the popup (from its first line): the tmux folder of the pane is
# the working directory there (display-popup -d).
# $1: project (the picker of p), folder (walk the tree from the current
# one), or nothing: enter for a project, ctrl-o for a folder.
new_agent() {
  local mode="${1:-}" pick m a dir out addr err home hdr
  local -a cmd=()
  local key here=""
  case "$mode" in
    project) hdr="enter: then the project (p) · esc: cancel" ;;
    folder) hdr="enter: then the folder (from ${PWD/#$HOME/\~}) · esc: cancel" ;;
    *) hdr="enter: in a project (p) · ctrl-o: pick a folder (from ${PWD/#$HOME/\~}) · esc: cancel" ;;
  esac
  pick="$(choices | fzf --delimiter=$'\t' --with-nth=3 --layout=reverse --gutter=' ' \
    --prompt="new ${mode:+$mode }agent › " --expect=ctrl-o --no-preview --header="$hdr")" \
    || return 0
  key="$(head -1 <<<"$pick")"
  pick="$(tail -1 <<<"$pick")"
  { [ "$key" = ctrl-o ] || [ "$mode" = folder ]; } && here=1
  IFS=$'\t' read -r m a _ <<<"$pick"
  [ "$m" = . ] && m=""
  # ~ is the home of the machine that runs it
  home="$HOME"
  [ -n "$m" ] && home="$("$HC" exec --on "$m" 'printf %s "$HOME"' 2>/dev/null || true)"
  if [ -n "$m" ]; then dir="$home"; else dir="$PWD"; fi
  dir="$(pick_folder "$m" "$home" "$dir" "$here")" || return 0
  [ -n "$dir" ] || return 0
  # A shell: the one of tmux here, else the one of that machine (no argv)
  if [ "$a" = shell ]; then
    [ -n "$m" ] || cmd=("$(tmux show -gv default-shell 2>/dev/null || echo "${SHELL:-/bin/sh}")")
  else
    cmd=("$a")
  fi
  [ "$a" = codex ] && cmd+=(--no-daemon)
  out="$(start "$m" "$dir" "$a" "${cmd[@]}")"
  addr="$(jq -r '.address // empty' <<<"$out" 2>/dev/null | head -1 || true)"
  if [ -z "$addr" ]; then
    err="$(jq -r '.error.message // empty' <<<"$out" 2>/dev/null || true)"
    echo; echo "Not started: ${err:-$out}"
    jq -r '.error.hint // empty' <<<"$out" 2>/dev/null || true
    read -rsn1 -p "(a key to close)" || true
    return 0
  fi
  open_t "$addr"
}

# herdr here <program> [args]: what the zsh functions of the agents run in
# a tmux pane (zsh fns/herdr). The program runs in a terminal of herdr-core,
# attached to this pane: the sidebar, the notifications and herdr-app see
# it. Quiet: nothing more than the program itself shows. Ctrl+\ detaches
# (it keeps running there); it ends, the pane is back to the shell. Without
# herdr-core, it runs as before.
here() {
  local a="$1" out t rc=0 where
  if [ -z "${TMUX:-}" ] || [ -z "$HC" ]; then exec "$@"; fi
  [ "$a" = codex ] && set -- "$@" --no-daemon
  app_labels "" "$PWD"
  where="$(basename "$PWD")"; [ "$PWD" = "$HOME" ] && where="~"
  out="$("$HC" run --bg --json --keep --rm --no-parent --cwd "$PWD" \
    --label "herdr.space=$SPACE" --label "herdr.tab=$TAB" \
    --label "where=$where / $a" -- "$@" 2>/dev/null)" || true
  t="$(jq -r '.address // empty' <<<"$out" 2>/dev/null || true)"
  [ -n "$t" ] || exec "$@"
  if [ -n "$APP_JSON" ]; then
    setsid -f "$SELF" app-names "" "$PWD" "$a" "$TAB" "$SPACE" "$SPACE_NEW" </dev/null >/dev/null 2>&1
  fi
  tmux set -p -t "${TMUX_PANE:-}" @hc "$t" 2>/dev/null || true
  "$HC" attach "$t" 2>/dev/null || rc=$?
  tmux set -pu -t "${TMUX_PANE:-}" @hc 2>/dev/null || true
  return "$rc"
}

# Gives terminal $1, started without Herdr, the labels of herdr-app.
adopt() {
  local t="$1" rec m dir a
  check_addr "$t"
  rec="$(full | jq -c --arg t "$t" 'select(.address == $t or .address == ("*/" + $t))' | head -1)"
  [ -n "$rec" ] || { echo "No terminal $t" >&2; exit 1; }
  if jq -e '.labels["herdr.space"]' <<<"$rec" >/dev/null; then
    echo "$t is in herdr-app already"; return 0
  fi
  m=""; [[ "$t" == */* ]] && m="${t%%/*}"
  dir="$(jq -r '.cwd' <<<"$rec")"
  a="$(jq -r '.status.app // .foreground.name // .argv[0] // "shell"' <<<"$rec")"
  app_labels "$m" "$dir"
  "$HC" label "$t" "herdr.space=$SPACE" "herdr.tab=$TAB" >/dev/null
  "$HC" keep "$t" >/dev/null 2>&1 || true
  [ -z "$APP_JSON" ] || app_names "$m" "$dir" "$a" "$TAB" "$SPACE" "$SPACE_NEW"
  echo "$t: in herdr-app now"
}

# --- Sidebar --------------------------------------------------------------

SIDE_W=25

# A coloured glyph for the program of an agent.
icon() {
  case "$1" in
    claude*)   printf '\033[38;5;173m✻' ;;
    codex*)    printf '\033[37m◎' ;;
    pi)        printf '\033[35mπ' ;;
    omp*)      printf '\033[36m◆' ;;
    opencode*) printf '\033[33m⌬' ;;
    *)         printf '\033[2m›' ;;
  esac
  printf '\033[0m'
}

# $1 padded with spaces to $2 characters (printf %-*s counts bytes: an
# accent or … would push the columns after it)
pad() {
  local n=$(( $2 - ${#1} ))
  printf '%s%*s' "$1" "$(( n > 0 ? n : 0 ))" ""
}

# The age of a time in ms since the epoch, like herdr-app: <1m, 5m, 2h, 3d.
age() {
  local s=$(( $(date +%s) - ${1:-0} / 1000 ))
  if   [ "$s" -lt 60 ];    then echo "<1m"
  elif [ "$s" -lt 3600 ];  then echo "$((s / 60))m"
  elif [ "$s" -lt 86400 ]; then echo "$((s / 3600))h"
  else echo "$((s / 86400))d"; fi
}

# The lines of the sidebar: id (address, new, or - for a heading), then what
# fzf shows. Grouped by status, the ones that need you first.
side_lines() {
  local cols rk addr app name mach ms state open key mark fw
  # The width of the sidebar pane itself
  # (or SIDE_COLS: the palette, a popup)
  cols="${SIDE_COLS:-$(tmux display -p -t "${TMUX_PANE:-}" '#{pane_width}' 2>/dev/null || true)}"
  [[ "$cols" =~ ^[0-9]+$ ]] || cols="${FZF_COLUMNS:-$SIDE_W}"
  local cur="" n w glyph here
  here="$(uname -n)"
  # The window of this sidebar: its agent is marked ▸ (not in the palette)
  SIDE_WIN=""
  [ -z "${SIDE_COLS:-}" ] && [ -n "${TMUX_PANE:-}" ] \
    && SIDE_WIN="$(tmux display -p -t "$TMUX_PANE" '#{window_id}' 2>/dev/null || true)"
  # The first line is the header of fzf (--header-lines=1)
  [ -n "$HC" ] || { printf -- '-\t \033[1mAgents\033[0m\n-\t\033[2m herdr-core not available\033[0m\n'; return 0; }
  local -A count=() needs=()
  local rows
  # One group per machine, this one first; in each, the agents that need you
  # first, then the most recent
  # herdr-core down or slow (timeout): an empty list, said in the header,
  # not a sidebar left blank (set -e would end here)
  local data hc_ok=1
  data="$(full 2>/dev/null)" || { hc_ok=""; data=""; }
  rows="$(printf '%s\n' "$data" | jq -r '
      select(.state == "live")
      | [ (.status.state // ""),
          .address,
          (.status.app // .foreground.name // .argv[0] // "shell"),
          # The title of the conversation, or else the folder
          # without the activity glyph agents put first (✳, ⠂…)
          (if (.title // "") != "" then (.title | sub("^[^\\p{L}\\p{N}]+"; ""))
           else ((.labels.where // "" | split(" / ") | first) // "") end),
          (.cwd // ""),
          (.status_ms // .created_ms // 0) ]
      # No empty field: read joins the tabs around one (a status null)
      | map(tostring | if . == "" then "-" else . end) | @tsv' 2>/dev/null \
    | while IFS=$'\t' read -r state addr app name cwd ms; do
        [ "$cwd" = - ] && cwd=""
        { [ -n "$name" ] && [ "$name" != - ]; } || name="$(basename "${cwd:-?}")"
        if [[ "$addr" == */* ]]; then mach="${addr%%/*}" key="1$mach"; else mach="$here" key="0"; fi
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$key" "$(rank "$state")" "$mach" "$state" "$addr" "$app" "$name" "$ms"
      done | sort -t $'\t' -k1,1 -k2,2n -k8,8nr || true)"
  local panes
  panes="$(tmux_agents)"
  # Header: the number of agents in each state, the ones that need you first
  local -A st=()
  local hdr=" \033[1mAgents\033[0m"
  if [ -n "$rows" ]; then
    while IFS=$'\t' read -r key rk mach state _; do
      st[${state:-other}]=$(( ${st[${state:-other}]:-0} + 1 ))
    done <<<"$rows"
  fi
  [ -n "${st[blocked]:-}" ] && hdr+=" \033[1;31m⚠${st[blocked]}\033[0m"
  [ -n "${st[error]:-}" ] && hdr+=" \033[31m✗${st[error]}\033[0m"
  [ -n "${st[working]:-}" ] && hdr+=" \033[34m●${st[working]}\033[0m"
  [ -n "${st[done]:-}" ] && hdr+=" \033[33m✓${st[done]}\033[0m"
  [ -n "${st[idle]:-}" ] && hdr+=" \033[2m○${st[idle]}\033[0m"
  [ -n "$hc_ok" ] || hdr+=" \033[2;31mherdr-core not answering\033[0m"
  printf -- '-\t%b\n' "$hdr"
  printf 'new-proj\t \033[1;32m+\033[0m New project agent\n'
  printf 'new-dir\t \033[1;32m+\033[0m New folder agent\n'
  [ -n "$rows$panes" ] || { printf -- '-\t\n-\t\033[2m No agent\033[0m\n'; return 0; }
  side_panes "$panes" "$cols"
  [ -n "$rows" ] || return 0
  while IFS=$'\t' read -r key rk mach state addr app name ms; do
    count[$mach]=$(( ${count[$mach]:-0} + 1 ))
    [ "$state" = blocked ] && needs[$mach]=$(( ${needs[$mach]:-0} + 1 ))
  done <<<"$rows"
  while IFS=$'\t' read -r key rk mach state addr app name ms; do
    if [ "$mach" != "$cur" ]; then
      cur="$mach"
      printf -- '-\t\n-\t \033[1m%s\033[0m \033[2m%s\033[0m' "$mach" "${count[$mach]}"
      [ -z "${needs[$mach]:-}" ] || printf ' \033[1;31m⚠%s\033[0m' "${needs[$mach]}"
      printf '\n'
    fi
    case "$state" in
      blocked) glyph='\033[1;31m⚠' ;; error) glyph='\033[31m✗' ;;
      done) glyph='\033[33m✓' ;; working) glyph='\033[34m●' ;;
      idle) glyph='\033[2m○' ;; *) glyph=' ' ;;
    esac
    open=""; mark=" "
    fw="$(find_window "$addr")"
    if [ -n "$fw" ]; then
      open='\033[1m'
      if [ -n "$SIDE_WIN" ] && [ "$(tmux display -p -t "$fw" '#{window_id}')" = "$SIDE_WIN" ]; then
        mark='\033[1;36m▸\033[0m'
      fi
    fi
    # icon, name, then age and status on the right
    w=$(( cols - 11 ))
    [ "$w" -lt 4 ] && w=4
    n="$name"; [ "${#n}" -gt "$w" ] && n="${n:0:$((w - 1))}…"
    printf '%s\t%b%s %b%s\033[0m \033[2m%3s\033[0m %b\033[0m\n' \
      "$addr" "$mark" "$(icon "$app")" "$open" "$(pad "$n" "$w")" "$(age "$ms")" "$glyph"
  done <<<"$rows"
}

# The sidebar takes the mouse back: out of copy mode, and with the mouse
# reporting of fzf on again when the terminal lost it (a drag on it then puts
# tmux in copy mode, and no click reaches fzf any more).
# Its width too: the one of @herdr_side_w, the same in every window (set
# when you resize a sidebar, see side_resized).
side_heal() {
  local p="${TMUX_PANE:-}" mode any tty w
  [ -n "$p" ] || return 0
  read -r mode any tty w < <(tmux display -p -t "$p" '#{pane_in_mode} #{mouse_any_flag} #{pane_tty} #{pane_width}' 2>/dev/null) || return 0
  [ "$mode" = 1 ] && tmux send-keys -t "$p" -X cancel 2>/dev/null
  [ "$any" = 0 ] && [ -w "$tty" ] && printf '\033[?1000h\033[?1002h\033[?1006h' > "$tty"
  # The same width in every window: tmux gives the sidebar the columns a
  # closed pane or a larger window leaves, it gives them back
  if [ "${w:-0}" != "$(side_width)" ]; then
    side_fitting
    tmux resize-pane -t "$p" -x "$(side_width)" 2>/dev/null || true
  fi
  return 0
}

side_width() {
  local w
  w="$(tmux show -gqv @herdr_side_w 2>/dev/null)"
  [[ "$w" =~ ^[0-9]+$ ]] && [ "$w" -ge 10 ] && echo "$w" || echo "$SIDE_W"
}

# The agents started by hand in a tmux pane (not in herdr-core): pane,
# program, folder, window. herdr-core and herdr-app don't know them.
tmux_agents() {
  local re
  re="^($(tr ' ' '|' <<<"$AGENTS"))\$"
  tmux list-panes -a -F "#{pane_id}	#{pane_current_command}	#{pane_current_path}	#{session_name}:#{window_index}" 2>/dev/null \
    | awk -F '\t' -v re="$re" '$2 ~ re'
}

# Their group in the sidebar, first: a click goes to the pane.
side_panes() {
  local panes="$1" cols="$2" id cmd path win n w mark
  [ -n "$panes" ] || return 0
  printf -- '-\t\n-\t \033[1mtmux\033[0m \033[2m%s\033[0m\n' "$(grep -c . <<<"$panes")"
  w=$(( cols - 11 ))
  [ "$w" -lt 4 ] && w=4
  while IFS=$'\t' read -r id cmd path win; do
    n="$(basename "$path")"; [ "${#n}" -gt "$w" ] && n="${n:0:$((w - 1))}…"
    mark=" "
    if [ -n "${SIDE_WIN:-}" ] && [ "$(tmux display -p -t "$id" '#{window_id}')" = "$SIDE_WIN" ]; then
      mark='\033[1;36m▸\033[0m'
    fi
    printf 'pane:%s\t%b%s %s \033[2m%3s\033[0m  \n' "$id" "$mark" "$(icon "$cmd")" "$(pad "$n" "$w")" "$win"
  done <<<"$panes"
}

# What runs in the sidebar pane: the list, again when fzf ends.
sidebar() {
  local rc start quick=0
  printf '\033]2;Agents\033\\'
  while :; do
    start=$SECONDS
    SHELL=/bin/bash fzf --ansi --no-sort --track --id-nth=1 \
      --delimiter=$'\t' --with-nth=2 --listen --no-input \
      --layout=reverse --info=hidden --no-scrollbar --border=none \
      --pointer=" " --gutter=" " --header-lines=1 --header-first \
      --color='bg+:236,gutter:-1,header:bold' \
      --bind "start:reload-sync($SELF side-lines)+execute-silent($SELF tick \$FZF_PORT side-lines </dev/null >/dev/null 2>&1 &)" \
      --bind "resize:reload-sync($SELF side-lines)" \
      --bind "load:transform:$SELF side-pos" \
      --bind "enter:transform:$SELF side-act {1}" \
      --bind "double-click:transform:$SELF side-act {1}" \
      --bind "left-click:transform:$SELF side-act {1}" \
      --bind "ctrl-x:execute-silent([[ {1} == new* ]] || [ {1} = - ] || [[ {1} == pane:* ]] || $SELF close {1})+reload-sync($SELF side-lines)" \
      --bind 'esc:execute-silent(tmux select-pane -l)' \
      < /dev/null && rc=0 || rc=$?
    side_log "sidebar ${TMUX_PANE:-}: fzf ended (rc $rc), started again"
    # fzf that cannot start (too old for these options, pane too small): not
    # twice a second for ever
    if [ $(( SECONDS - start )) -lt 2 ]; then quick=$(( quick + 1 )); else quick=0; fi
    if [ "$quick" -ge 5 ]; then
      printf '\n fzf does not start (rc %s):\n fzf 0.6x or newer?\n' "$rc"
      side_log "sidebar ${TMUX_PANE:-}: fzf does not start, sidebar stops"
      exec sleep infinity
    fi
    sleep 0.5
  done
}

# fzf action after a load of the sidebar list: when its window was just
# shown (@herdr_side_goto, set by ensure, and at start), the cursor goes on
# the agent of the window (marked ▸). Each sidebar has its own cursor: without
# it, the one of the window you go to stays where you left it.
side_pos() {
  local p="${TMUX_PANE:-}" n
  [ -n "$p" ] || return 0
  [ "$(tmux show -pqv -t "$p" @herdr_side_goto 2>/dev/null)" = 0 ] && return 0
  tmux set -p -t "$p" @herdr_side_goto 0 2>/dev/null || true
  # Its place in the list: the line of ▸, less the header (--header-lines=1)
  n="$(side_lines | grep -n '▸' | head -1 | cut -d: -f1)" || true
  [[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -gt 1 ] && echo "pos($(( n - 1 )))"
  return 0
}

# What enter does on a line of the sidebar, as fzf actions.
# The client is the one that shows this sidebar and used it last (the
# click): with several terminals on a session, tmux would pick one itself.
side_act() {
  local c
  c="$(side_client)"
  case "$1" in
    -) echo ignore ;;
    # In the background: the popup stays open while the agent is chosen, the
    # sidebar must not wait for it
    new-proj) echo "execute-silent($SELF side-new project $c >/dev/null 2>&1 </dev/null &)" ;;
    new-dir) echo "execute-silent($SELF side-new folder $c >/dev/null 2>&1 </dev/null &)" ;;
    pane:%*) echo "execute-silent(HERDR_CLIENT=$c $SELF goto-pane ${1#pane:})" ;;
    *) echo "execute-silent(HERDR_CLIENT=$c $SELF open $1)+reload-sync($SELF side-lines)" ;;
  esac
}

# The tmux client of this sidebar (TMUX_PANE): among the ones that show its
# window, the one active last
side_client() {
  local win
  win="$(tmux display -p -t "${TMUX_PANE:-}" '#{window_id}' 2>/dev/null)" || return 0
  tmux list-clients -F '#{client_activity} #{client_name} #{window_id}' 2>/dev/null \
    | awk -v w="$win" '$3 == w' | sort -rn | head -1 | cut -d' ' -f2
}

# The new agent window, from the sidebar: in the folder of the pane beside.
# The popup of a new agent, on client $1 (see side_client), in the folder of
# the pane beside the sidebar (the one active before it)
# $1: project or folder (see new_agent)
side_new() {
  local mode="${1:-}" client="${2:-}" win p dir
  win="$(tmux display -p -t "${TMUX_PANE:-}" '#{window_id}')"
  p="$(tmux list-panes -t "$win" -F '#{pane_last} #{pane_id} #{pane_start_command}' \
    | grep -v -- "$SELF sidebar" | sort -rn | head -1 | cut -d' ' -f2)" || true
  dir="$(tmux display -p -t "${p:-$win}" '#{pane_current_path}')"
  [ -n "$client" ] || client="$(side_client)"
  tmux display-popup ${client:+-c "$client"} -E -w 90% -h 80% -d "$dir" \
    -T "#[align=centre] New ${mode:+$mode }agent " "$SELF new $mode"
}

# The sidebar is one pane per window, on its right, the full height: none
# moves from a window to another. Each one is made when its window is shown
# (hooks of herdr.conf: herdr sidebar ensure) while @herdr_side_on says that
# it is wanted, and only the ones on screen refresh (see tick).

# The sidebar panes of window $1, or of every window
side_in() {
  local -a scope=(-a)
  local id cmd
  [ -n "${1:-}" ] && scope=(-t "$1")
  tmux list-panes "${scope[@]}" -F '#{pane_id} #{pane_start_command}' 2>/dev/null \
    | while read -r id cmd; do
        if [[ "$cmd" == *"$SELF sidebar"* ]]; then echo "$id"; fi
      done || true
}

# The hooks of herdr.conf run in the background and several of them come at
# once (a new window: after-new-window, then session-window-changed). Without
# a lock both see no sidebar and both make one. One at a time, per server.
side_lock() {
  local sock="${TMUX:-}"; sock="${sock%%,*}"
  exec 8>"${XDG_RUNTIME_DIR:-/tmp}/herdr-tmux-side-$(id -u)-$(printf '%s' "$sock" | md5sum | cut -c1-8)"
  flock -w 5 8 || true
}

# prefix + a or the agents button: every sidebar shows or goes.
side_toggle() {
  local id
  # On, but no sidebar left (all closed by hand): it shows again
  if [ -n "$(tmux show -gqv @herdr_side_on)" ] && [ -n "$(side_in)" ]; then
    tmux set -gu @herdr_side_on
    for id in $(side_in); do tmux kill-pane -t "$id" 2>/dev/null || true; done
    side_log "toggle: off"
    return 0
  fi
  tmux set -g @herdr_side_on 1
  side_log "toggle: on"
  # In the window of every client, the others get theirs when shown
  for id in $( { echo "${1:-}"; tmux list-clients -F '#{window_id}' 2>/dev/null; } | sort -u); do
    side_ensure "$id"
  done
}

# prefix + a in window $1: hidden, the sidebars show and this one gets the
# focus; shown, it gets the focus; already focused, they all go.
side_key() {
  local win="${1:-}" p
  [ -n "$win" ] || return 0
  if [ -n "$(tmux show -gqv @herdr_side_on)" ]; then
    p="$(side_in "$win" | head -1)"
    if [ -n "$p" ] && [ "$(tmux display -p -t "$win" '#{pane_id}')" = "$p" ]; then
      side_toggle "$win"
      return 0
    fi
    [ -n "$p" ] || side_ensure "$win"
  else
    side_toggle "$win"
  fi
  p="$(side_in "$win" | head -1)"
  [ -n "$p" ] && tmux select-pane -t "$p"
  return 0
}

# Hook of herdr.conf, when window $1 is shown: its sidebar, made when it has
# none (only one: the others, left by a join-pane, go), refreshed at once
# when it has one.
side_ensure() {
  local win="${1:-}" first="" id port
  [ -n "$win" ] || return 0
  [ -n "$(tmux show -gqv @herdr_side_on)" ] || return 0
  for id in $(side_in "$win"); do
    if [ -z "$first" ]; then first="$id"; continue; fi
    side_log "ensure: second sidebar $id in $win goes"
    tmux kill-pane -t "$id" 2>/dev/null || true
  done
  if [ -n "$first" ]; then
    side_fit "$first"
    # Its cursor goes on the agent of the window, after the refresh (load)
    tmux set -p -t "$first" @herdr_side_goto 1 2>/dev/null || true
    port="$(tmux show -pqv -t "$first" @herdr_side_port 2>/dev/null)"
    [[ "$port" =~ ^[0-9]+$ ]] && { curl -fsS -m 1 -XPOST "localhost:$port" \
      -d "reload-sync($SELF side-lines)" >/dev/null 2>&1 || true; }
    return 0
  fi
  id="$(tmux split-window -hf -d -l "$(side_width)" -P -F '#{pane_id}' -t "$win" "$SELF sidebar" 2>&1)" \
    && side_log "ensure: $id in $win" || side_log "ensure: no sidebar in $win: $id"
  return 0
}

# Sidebar pane $1 at the width of every sidebar
side_fit() {
  local w
  w="$(tmux display -p -t "$1" '#{pane_width}' 2>/dev/null)" || return 0
  if [ "$w" != "$(side_width)" ]; then
    side_fitting
    tmux resize-pane -t "$1" -x "$(side_width)" 2>/dev/null || true
  fi
  return 0
}

# Our own resizes (to the width of every sidebar, maybe less in a narrow
# window) are not yours: side_resized does not record them
side_fitting() {
  tmux set -g @herdr_side_fitting "$(date +%s)" 2>/dev/null || true
}

# Hook of herdr.conf, after a resize-pane in window $1 (a drag on a border is
# one): the width of its sidebar, when it changed, is the one of every
# sidebar from now on.
side_resized() {
  local p w t
  t="$(tmux show -gqv @herdr_side_fitting 2>/dev/null)"
  [ $(( $(date +%s) - ${t:-0} )) -lt 2 ] && return 0
  p="$(side_in "${1:-}" | head -1)"
  [ -n "$p" ] || return 0
  # A drag sends one resize per move, in background hooks that may end out
  # of order: the width once it stopped
  sleep 0.4
  w="$(tmux display -p -t "$p" '#{pane_width}' 2>/dev/null)" || return 0
  [[ "$w" =~ ^[0-9]+$ ]] && [ "$w" -ge 10 ] || return 0
  [ "$w" = "$(side_width)" ] && return 0
  tmux set -g @herdr_side_w "$w"
  side_log "resized: sidebars now $w columns wide"
  return 0
}

# Hook of herdr.conf, when a window changes size: its sidebar keeps its width
side_window_resized() {
  local p
  p="$(side_in "${1:-}" | head -1)"
  [ -n "$p" ] && side_fit "$p"
  return 0
}

# What went wrong with the sidebar, for a later look:
# $XDG_RUNTIME_DIR/herdr-sidebar.log (the last 200 lines are kept)
side_log() {
  local f="${XDG_RUNTIME_DIR:-/tmp}/herdr-sidebar.log"
  printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$f"
  [ "$(wc -l <"$f")" -gt 400 ] && { tail -200 "$f" >"$f.tmp" && mv "$f.tmp" "$f"; }
  return 0
}

# Hook of herdr.conf, when a pane ends: a window with only its sidebar left
# closes, as it would without it (and the session with its last window).
side_alone() {
  local win
  tmux list-panes -a -F '#{window_id} #{pane_start_command}' 2>/dev/null \
    | awk -v side="$SELF sidebar" '{ n[$1]++; if (index($0, side)) s[$1]++ }
        END { for (w in n) if (n[w] == s[w]) print w }' \
    | while read -r win; do
        side_log "alone: window $win with only its sidebar closes"
        tmux kill-window -t "$win" 2>/dev/null || true
      done || true
  # The columns of the pane that ended went to the sidebar too: back
  for win in $(tmux list-clients -F '#{window_id}' 2>/dev/null | sort -u); do
    side_window_resized "$win"
  done
  return 0
}

# Hook of herdr.conf, after a split in window $1: when its sidebar was split
# (it is not the full height of the window any more, or not on its right
# edge), the new pane goes beside the pane on the left of the sidebar, the
# same way (-v or -h), and a shell there starts again in the folder of that
# pane. The sidebar gets its height and width back.
side_unsplit() {
  local p win sl sw sh ww wh act n="" nl="" id l t w col target="" orient
  p="$(side_in "${1:-}" | head -1)"
  [ -n "$p" ] || return 0
  read -r win sl sw sh ww wh < <(tmux display -p -t "$p" \
    '#{window_id} #{pane_left} #{pane_width} #{pane_height} #{window_width} #{window_height}')
  [ "$sh" = "$wh" ] && [ $(( sl + sw )) = "$ww" ] && return 0
  # The new pane: in the column of the sidebar (below it, or on its right),
  # the active one when there are several
  act="$(tmux display -p -t "$win" '#{pane_id}')"
  while read -r id l; do
    [ "$id" = "$p" ] && continue
    [ "$l" -ge "$sl" ] || continue
    if [ -z "$n" ] || [ "$id" = "$act" ]; then n="$id" nl="$l"; fi
  done < <(tmux list-panes -t "$win" -F '#{pane_id} #{pane_left}')
  if [ -z "$n" ]; then
    # A split across the whole window (split-window -f): nothing in the
    # column of the sidebar, which goes back on the right, full height
    id="$(tmux list-panes -t "$win" -F '#{pane_id}' | grep -vx -- "$p" | head -1)" || true
    [ -n "$id" ] || return 0
    side_log "unsplit: sidebar $p back to the full height (split across the window)"
    side_fitting
    tmux join-pane -hf -d -l "$(side_width)" -s "$p" -t "$id" 2>/dev/null || true
    return 0
  fi
  if [ "$nl" = "$sl" ]; then orient=-v; else orient=-h; fi
  # The pane on the left of the column of the sidebar, the top one
  col=$(( nl < sl ? nl : sl ))
  while read -r id l t w; do
    if [ "$id" != "$p" ] && [ "$id" != "$n" ] && [ $(( l + w + 1 )) = "$col" ]; then
      target="$id"; break
    fi
  done < <(tmux list-panes -t "$win" -F '#{pane_id} #{pane_left} #{pane_top} #{pane_width}' | sort -k3,3n)
  side_log "unsplit: $n out of the sidebar $p ($orient, beside ${target:-nothing})"
  if [ -n "$target" ]; then
    tmux join-pane "$orient" -d -s "$n" -t "$target"
    # A shell started by the split: again, in the folder of the pane beside
    [ -z "$(tmux display -p -t "$n" '#{pane_start_command}')" ] \
      && tmux respawn-pane -k -t "$n" -c "$(tmux display -p -t "$target" '#{pane_current_path}')"
  else
    # The sidebar was alone in its window: it goes back on the right, full
    tmux join-pane -hf -d -s "$p" -t "$n"
  fi
  side_fitting
  tmux resize-pane -t "$p" -x "$(side_width)" 2>/dev/null || true
  tmux select-pane -t "$n"
  return 0
}

# --- Palette (Ctrl+Shift+P) -----------------------------------------------

# The windows of every session, then the agents (like the sidebar), in a
# popup with a search: enter goes there. The current window is not in it.
palette_lines() {
  local cur cols id sess idx hc
  local -A agent_win=() where=()
  cur="$(tmux display -p '#{window_id}')"
  # The windows that show an agent: the agent line stands for them (with
  # where it is at the end), not a second line. @hc: opened by herdr open,
  # or herdr here; tmux_agents: started by hand in a pane.
  while IFS=$'\t' read -r id sess idx hc; do
    [ -n "$hc" ] || continue
    agent_win[$id]=1; where[$hc]="$sess:$idx"
  done < <(tmux list-panes -a -F "#{window_id}	#{session_name}	#{window_index}	#{@hc}")
  while IFS=$'\t' read -r id _ _ _; do
    [ -n "$id" ] || continue
    read -r hc sess < <(tmux display -p -t "$id" '#{window_id} #{session_name}:#{window_index}')
    agent_win[$hc]=1; where[pane:$id]="$sess"
  done <<<"$(tmux_agents)"
  tmux list-windows -a -F "#{window_id}	#{session_name}	#{window_index}	#{window_name}	#{pane_current_path}	#{window_activity}" \
    | sort -t $'\t' -k6,6nr \
    | while IFS=$'\t' read -r id sess idx name path _; do
        [ "$id" = "$cur" ] && continue
        [ -n "${agent_win[$id]:-}" ] && continue
        printf 'win:%s\t \033[34m□\033[0m %s \033[2m%s:%s\033[0m  \033[2m%s\033[0m\n' \
          "$id" "$name" "$sess" "$idx" "${path/#$HOME/\~}"
      done
  [ -n "$HC" ] || return 0
  cols="$(tput cols 2>/dev/null || echo 80)"; [ "$cols" -gt 70 ] && cols=70
  # The agents, without the headings (one line per machine) of the sidebar,
  # and the window that shows each one, when there is one
  SIDE_COLS="$cols" side_lines | grep -v $'^-\t' \
    | while IFS=$'\t' read -r id line; do
        if [ -n "${where[$id]:-}" ]; then
          printf '%s\t%s \033[2m%s\033[0m\n' "$id" "$line" "${where[$id]}"
        else
          printf '%s\t%s\n' "$id" "$line"
        fi
      done || true
}

palette() {
  local sel id
  sel="$(palette_lines | fzf --ansi --delimiter=$'\t' --with-nth=2 --no-sort \
    --layout=reverse --info=hidden --gutter=' ' --prompt='› ' \
    --header='windows and agents · enter: go · esc: cancel')" || return 0
  id="${sel%%$'\t'*}"
  case "$id" in
    win:@*) id="${id#win:}"
            tmux switch-client -t "$(tmux display -p -t "$id" '#{session_id}')" \; select-window -t "$id" ;;
    pane:%*) id="${id#pane:}"
             tmux switch-client -t "$(tmux display -p -t "$id" '#{session_id}')" \; select-window -t "$id" \; select-pane -t "$id" ;;
    new-proj) need_hc; new_agent project ;;
    new-dir) need_hc; new_agent folder ;;
    -|"") ;;
    *) open_t "$id" ;;
  esac
}

# --- Notifications --------------------------------------------------------

WATCH_LOCK="${XDG_RUNTIME_DIR:-/tmp}/herdr-tmux-watch-$(id -u)"

# Follows herdr-core events. On each change it reads the blocked terminals,
# puts their number in @herdr_blocked and shows a message on every tmux
# client for the ones that just got blocked (except on a client that already
# shows that agent). Ends with the tmux server.
watch() {
  local sock="${1:-}"
  local restart=""
  [ "$sock" = restart ] && { restart=1; sock="${2:-}"; }
  [ -n "$HC" ] || return 0
  [ -n "$sock" ] || sock="$(tmux display-message -p '#{socket_path}' 2>/dev/null)" || return 0
  # restart: tmux starts the new one, detached from the shell that asks
  if [ -n "$restart" ]; then
    watch_stop
    sleep 1
    tmux -S "$sock" run-shell -b "$SELF watch '$sock'"
    return 0
  fi
  local lock="$WATCH_LOCK-$(printf '%s' "$sock" | md5sum | cut -c1-8)"
  exec 9>"$lock"
  flock -n 9 || return 0
  echo $$ > "$lock.pid"
  export TMUX_SOCK="$sock"
  tm() { tmux -S "$TMUX_SOCK" "$@"; }
  local -A prev=() now=() kind=() was=()
  local line type t k addr agent where status first=1
  while tm has-session 2>/dev/null; do
    while IFS= read -r line; do
      tm has-session 2>/dev/null || return 0
      IFS=$'\t' read -r type t k < <(jq -r '[.params.type // "snapshot", .params.terminal // "-", .params.data.status.kind // "-"] | map(if . == "" then "-" else . end) | @tsv' <<<"$line" 2>/dev/null) || continue
      [ "$type" = heartbeat ] && continue
      [ "$k" != - ] && [ "$t" != - ] && kind[$t]="$k"
      now=()
      while IFS=$'\t' read -r addr agent where status; do
        # On the desktop too: blocked, done or failed, once per change
        if [ -z "$first" ] && [ "${was[$addr]:-}" != "$status" ]; then
          desktop_notify "$addr" "$agent" "$where" "$status" "${kind[$addr]:-}"
        fi
        was[$addr]="$status"
        [ "$status" = blocked ] || continue
        now[$addr]=1
        [ -n "$first" ] || [ -n "${prev[$addr]:-}" ] && continue
        notify "$addr" "$agent" "$where" "${kind[$addr]:-}"
      done < <(terminals 2>/dev/null)
      first=""
      prev=()
      for addr in "${!now[@]}"; do prev[$addr]=1; done
      if [ "${#now[@]}" -gt 0 ]; then tm set -g @herdr_blocked "${#now[@]}"; else tm set -gu @herdr_blocked; fi
      tm refresh-client -S 2>/dev/null || true
    done < <("$HC" events --json 2>/dev/null 9>&-)
    sleep 5 9>&-   # herdr-core restarted or unreachable: follow it again
  done
}

notify() {
  local addr="$1" agent="$2" where="$3" k="$4" msg client win
  msg="⚠ $agent · $where needs you${k:+ ($k)} · prefix+a"
  msg="${msg//#/##}"
  win="$(tm list-panes -a -F '#{window_id} #{@hc}' 2>/dev/null | awk -v t="$addr" '$2 == t { print $1; exit }')"
  while read -r client cwin; do
    [ -n "$win" ] && [ "$cwin" = "$win" ] && continue
    tm display-message -c "$client" -d 10000 "$msg" 2>/dev/null || true
  done < <(tm list-clients -F '#{client_name} #{window_id}' 2>/dev/null)
}

# A desktop notification (notify-send) for agent $2 (terminal $1) in $3,
# now $4: not when herdr-app runs (it has its own), nor when notify-send is
# missing. A click on it goes to the agent (herdr focus).
desktop_notify() {
  local addr="$1" agent="$2" where="$3" status="$4" k="$5" body urgency=normal
  case "$status" in
    blocked) body="needs you${k:+ ($k)}"; urgency=critical ;;
    # Every answer of an agent ends in done: only when asked for
    done) [ -n "$(tm show -gqv @herdr_notify_done 2>/dev/null)" ] || return 0; body="finished" ;;
    error) body="ended with an error" ;;
    *) return 0 ;;
  esac
  command -v notify-send >/dev/null 2>&1 || return 0
  pgrep -x herdr-app >/dev/null 2>&1 && return 0
  # In the background (notify-send waits for the click), without the lock
  # of watch (fd 9)
  (
    act="$(notify-send -a Herdr -u "$urgency" -A default=Open "$agent · $where" "$body" 2>/dev/null)" || exit 0
    [ "$act" = default ] && exec "$SELF" focus "$addr"
  ) 9>&- </dev/null >/dev/null 2>&1 &
  return 0
}

# Goes to agent $1 from outside tmux (a click on a notification): the tmux
# client used last shows its window (opened when needed), and the terminal
# window of that client comes to the front in Hyprland.
focus() {
  local t="$1" client cpid win pid addr
  check_addr "$t"
  read -r _ client cpid < <(tmux list-clients -F '#{client_activity} #{client_name} #{client_pid}' 2>/dev/null | sort -rn | head -1) || true
  [ -n "${client:-}" ] || return 0
  win="$(find_window "$t")"
  if [ -z "$win" ]; then
    open_t "$t"
    win="$(find_window "$t")"
  fi
  if [ -n "$win" ]; then
    tmux switch-client -c "$client" -t "$(tmux display -p -t "$win" '#{session_id}')" \; \
      select-window -t "$win" \; select-pane -t "$win" 2>/dev/null || true
  fi
  # The terminal of the client: the first parent of it that is a Hyprland
  # window
  command -v hyprctl >/dev/null 2>&1 || return 0
  pid="$cpid"
  while [ -n "$pid" ] && [ "$pid" -gt 1 ]; do
    addr="$(hyprctl clients -j 2>/dev/null | jq -r --argjson p "$pid" '.[] | select(.pid == $p) | .address' | head -1)"
    if [ -n "$addr" ]; then
      hyprctl dispatch focuswindow "address:$addr" >/dev/null 2>&1 || true
      return 0
    fi
    pid="$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')"
  done
  return 0
}

watch_stop() {
  local f pid kids
  for f in "$WATCH_LOCK"-*.pid; do
    [ -e "$f" ] || continue
    # The watcher first, then its children (hc events): the other way, it
    # would start its sleep before following herdr-core again
    pid="$(cat "$f")"
    kids="$(pgrep -P "$pid" 2>/dev/null || true)"
    kill "$pid" 2>/dev/null || true
    [ -z "$kids" ] || kill $kids 2>/dev/null || true
    rm -f "$f"
  done
}

has() {
  [ -n "$HC" ] && echo 1
  return 0
}

# Prints nothing for zero, so that the agents button, shown when the output
# is not empty, hides. Never fails: tmux calls it every few seconds and would
# show an error in place of the button.
count() {
  local n
  [ -n "$HC" ] || return 0
  n="$("$HC" ls 2>/dev/null | jq -r '.terminals | length' 2>/dev/null)" || return 0
  [ "${n:-0}" -gt 0 ] 2>/dev/null && echo "$n"
  return 0
}

list() {
  local addr agent where status open
  while IFS=$'\t' read -r addr agent where status; do
    [ -n "$addr" ] || continue
    open=""
    [ -n "$(find_window "$addr")" ] && open="  [window open]"
    printf '%-5s %-12s %s (%s)%s\n' "$addr" "$agent" "$where" "$status" "$open"
  done < <(terminals)
}

case "${1:-}" in
  "")
    need_hc
    if [ -n "${TMUX:-}" ]; then menu; else exec "$HC"; fi
    ;;
  menu) need_hc; menu "${2:-}" ;;
  prepare) prepare "${2:-}" ;;
  toggle|open|close)
    need_hc
    [ -n "${2:-}" ] || { echo "usage: herdr $1 <terminal>" >&2; exit 2; }
    case "$1" in toggle) toggle "$2" ;; open) open_t "$2" ;; close) close_t "$2" ;; esac
    ;;
  popup) popup ;;
  palette) palette ;;
  sidebar)
    case "${2:-}" in
      toggle) side_lock; side_toggle "${3:-}" ;;
      key) side_lock; side_key "${3:-}" ;;
      ensure) side_lock; side_ensure "${3:-}" ;;
      alone) side_lock; side_alone ;;
      unsplit) side_lock; side_unsplit "${3:-}" ;;
      resized) side_resized "${3:-}" ;;
      window-resized) side_window_resized "${3:-}" ;;
      *) sidebar ;;
    esac ;;
  side-lines) side_lines ;;
  side-act) side_act "${2:-}" ;;
  side-pos) side_pos ;;
  focus) [ -n "${2:-}" ] || { echo "usage: herdr focus <terminal>" >&2; exit 2; }; need_hc; focus "$2" ;;
  side-new) side_new "${2:-}" "${3:-}" ;;
  goto-pane)
    [[ "${2:-}" =~ ^%[0-9]+$ ]] || exit 2
    tmux switch-client ${HERDR_CLIENT:+-c "$HERDR_CLIENT"} -t "$(tmux display -p -t "$2" '#{session_id}')" \; select-window -t "$2" \; select-pane -t "$2"
    ;;
  app-names) shift; app_names "$@" ;;
  here) shift; [ $# -gt 0 ] || { echo "usage: herdr here <program> [args]" >&2; exit 2; }; here "$@" ;;
  adopt) need_hc; [ -n "${2:-}" ] || { echo "usage: herdr adopt <terminal>" >&2; exit 2; }; adopt "$2" ;;
  new) need_hc; new_agent "${2:-}" ;;
  has) has ;;
  lines) lines ;;
  tick) tick "${2:-}" "${3:-}" ;;
  watch) watch "${2:-}" "${3:-}" ;;
  list) need_hc; list ;;
  count) count ;;
  -h|--help) sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \?//' ;;
  *) echo "unknown command: $1 (popup, sidebar, new, here, adopt, menu, prepare, toggle, open, close, list, count, watch)" >&2; exit 2 ;;
esac
