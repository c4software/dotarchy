#!/bin/bash

# Toggle grouping of windows in the current workspace.
# If no windows are grouped, group all visible windows except the active one.
# If there are grouped windows, ungroup them.
# Usage: dotarchy-toggle-group

current_workspace=$(hyprctl activeworkspace -j | jq '.id')
group_exists=$(hyprctl clients -j | jq "[.[] | select(.workspace.id == $current_workspace and (.grouped | length > 0))] | length")

if [ "$group_exists" -gt 0 ]; then
    # There are grouped windows, ungroup them
    hyprctl dispatch togglegroup
else
    WS="$current_workspace"

    mapfile -t CLIENTS < <(
        hyprctl clients -j | jq -r --argjson ws "$WS" '.[] 
            | select(.workspace.id == $ws) 
            | "\(.address) \(.at[0]) \(.at[1])"' | sort -k2n -k3n
    )

    if ((${#CLIENTS[@]} == 0)); then
        exit 0
    fi

    read FIRST FX FY <<<"${CLIENTS[0]}"

    hyprctl dispatch focuswindow address:"$FIRST"
    hyprctl dispatch togglegroup

    for c in "${CLIENTS[@]:1}"; do
        read CLIENT CX CY <<<"$c"

        if ((CX > FX)); then
            DIR="l"
        elif ((CX < FX)); then
            DIR="r"
        elif ((CY > FY)); then
            DIR="d"
        else
            DIR="u"
        fi

        echo "client: $CLIENT cx:$CX cy:$CY dir:$DIR, first:$FIRST fx:$FX fy:$FY"

        hyprctl dispatch focuswindow address:"$CLIENT"
        hyprctl dispatch moveintogroup "$DIR"
    done
fi