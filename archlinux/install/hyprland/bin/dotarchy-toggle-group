#!/bin/bash

# Toggle grouping of windows in the current workspace.
# If no windows are grouped, group all visible windows except the active one.
# If there are grouped windows, ungroup them.
# Usage: dotarchy-toggle-group

current_workspace=$(hyprctl activeworkspace -j | jq .id)
active_window=$(hyprctl activewindow -j | jq .address)

group_exists=$(hyprctl clients -j | jq "[.[] | select(.workspace.id == $current_workspace and (.grouped | length > 0))] | length")

if [ "$group_exists" -gt 0 ]; then
    hyprctl dispatch togglegroup
else
    windows=$(hyprctl clients -j | jq -r ".[] | select(.workspace.id == $current_workspace and .hidden == false and .floating == false) | .address")
    
    window_count=$(echo "$windows" | wc -l)
    
    if [ "$window_count" -le 1 ]; then
        hyprctl dispatch togglegroup
        exit 0
    fi
    
    hyprctl dispatch focuswindow address:$active_window
    hyprctl dispatch togglegroup
    sleep 0.1
    
    for window in $windows; do
        if [ "$window" != "$active_window" ]; then
            hyprctl dispatch focuswindow address:$window
            sleep 0.1
            hyprctl dispatch moveintogroup r
            sleep 0.1
        fi
    done
    
    hyprctl dispatch focuswindow address:$active_window
fi