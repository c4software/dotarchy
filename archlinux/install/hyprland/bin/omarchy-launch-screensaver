#!/bin/bash

# Exit early if we don't have the tte show
if ! command -v tte &>/dev/null; then
  exit 1
fi

# Exit early if screensaver is already running
pgrep -f "alacritty --class Screensaver" && exit 0

# Allow screensaver to be turned off but also force started
if [[ $1 != "force" ]]; then
  exit 1
fi

# Detect compositor
if [[ "$XDG_CURRENT_DESKTOP" == "Niri" ]]; then
  # Niri implementation
  outputs=$(niri msg -j outputs | jq -r '.[].name')
  focused=$(niri msg -j outputs | jq -r '.[] | select(.focused == true).name')
  
  for m in $outputs; do
    niri msg action focus-monitor --output "$m"
    niri msg action spawn -- \
      alacritty --class Screensaver \
      --config-file ~/.config/alacritty/screensaver.toml \
      -e omarchy-cmd-screensaver
  done
  
  niri msg action focus-monitor --output "$focused"
else
  # Hyprland implementation
  focused=$(hyprctl monitors -j | jq -r '.[] | select(.focused == true).name')
  
  for m in $(hyprctl monitors -j | jq -r '.[] | .name'); do
    hyprctl dispatch focusmonitor $m
    hyprctl dispatch exec -- \
      alacritty --class Screensaver \
      --config-file ~/.config/alacritty/screensaver.toml \
      -e omarchy-cmd-screensaver
  done
  
  hyprctl dispatch focusmonitor $focused
fi