binds {
    // Close windows
    Mod+W hotkey-overlay-title="Close window" { close-window; }

    // Control tiling and window modes
    F11 hotkey-overlay-title="Maximize column" { fullscreen-window; }
    Mod+Alt+Up hotkey-overlay-title="Maximize column" { maximize-column; }
    Mod+Alt+Down hotkey-overlay-title="Restore column" { maximize-column; }
    Mod+Alt+Left hotkey-overlay-title="Expand to width" { expand-column-to-available-width; }
    Mod+Alt+Right hotkey-overlay-title="Expand to width" { expand-column-to-available-width; }

    // Detached fullscreen windows
    Mod+F11 hotkey-overlay-title="Toggle windowed fullscreen" { toggle-windowed-fullscreen; }

    // Center floating window (Niri handles floating differently)
    Mod+P hotkey-overlay-title="Center column" { center-column; }

    // Move focus with Mod + arrow keys
    Mod+Left hotkey-overlay-title="Focus left" { focus-column-left; }
    Mod+Right hotkey-overlay-title="Focus right" { focus-column-right; }
    Mod+Up hotkey-overlay-title="Focus workspace up" { focus-workspace-up; }
    Mod+Down hotkey-overlay-title="Focus workspace down" { focus-workspace-down; }

    // Switch workspaces with Mod + [1-9,0] (in bépo)
    Mod+quotedbl hotkey-overlay-title="Workspace 1" { focus-workspace 1; }
    Mod+less hotkey-overlay-title="Workspace 2" { focus-workspace 2; }
    Mod+greater hotkey-overlay-title="Workspace 3" { focus-workspace 3; }
    Mod+parenleft hotkey-overlay-title="Workspace 4" { focus-workspace 4; }
    Mod+parenright hotkey-overlay-title="Workspace 5" { focus-workspace 5; }
    Mod+at hotkey-overlay-title="Workspace 6" { focus-workspace 6; }
    Mod+plus hotkey-overlay-title="Workspace 7" { focus-workspace 7; }

    // Move active window to workspace with Mod + Ctrl + [1-9,0] (in bépo)
    Mod+Ctrl+quotedbl hotkey-overlay-title="Move to workspace 1" { move-column-to-workspace 1; }
    Mod+Ctrl+less hotkey-overlay-title="Move to workspace 2" { move-column-to-workspace 2; }
    Mod+Ctrl+greater hotkey-overlay-title="Move to workspace 3" { move-column-to-workspace 3; }
    Mod+Ctrl+parenleft hotkey-overlay-title="Move to workspace 4" { move-column-to-workspace 4; }
    Mod+Ctrl+parenright hotkey-overlay-title="Move to workspace 5" { move-column-to-workspace 5; }
    Mod+Ctrl+at hotkey-overlay-title="Move to workspace 6" { move-column-to-workspace 6; }
    Mod+Ctrl+plus hotkey-overlay-title="Move to workspace 7" { move-column-to-workspace 7; }

    // Swap windows with Mod + Shift + arrow keys
    Mod+Shift+Left hotkey-overlay-title="Move column left" { move-column-left; }
    Mod+Shift+Right hotkey-overlay-title="Move column right" { move-column-right; }
    Mod+Shift+Up hotkey-overlay-title="Move window up" { move-window-up; }
    Mod+Shift+Down hotkey-overlay-title="Move window down" { move-window-down; }

    // Overview mode
    Mod+Tab hotkey-overlay-title="Toggle overview" { toggle-overview; }

    // Resize active window
    Alt+Left hotkey-overlay-title="Shrink width" { set-column-width "-10%"; }
    Alt+Right hotkey-overlay-title="Expand width" { set-column-width "+10%"; }
    Alt+Up hotkey-overlay-title="Shrink height" { set-window-height "-10%"; }
    Alt+Down hotkey-overlay-title="Expand height" { set-window-height "+10%"; }

    // Scroll through workspaces with Mod + scroll
    Mod+WheelScrollDown cooldown-ms=150 hotkey-overlay-title="Next workspace" { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 hotkey-overlay-title="Prev workspace" { focus-workspace-up; }

    // Move workspaces to other monitors
    Mod+Shift+Alt+Left hotkey-overlay-title="Move workspace left" { move-workspace-to-monitor-left; }
    Mod+Shift+Alt+Right hotkey-overlay-title="Move workspace right" { move-workspace-to-monitor-right; }

    // Group/ungroup windows
    Mod+G hotkey-overlay-title="Group/Ungroup window into tabbed display" { toggle-column-tabbed-display; }
    Mod+Q hotkey-overlay-title="Comsume window into the group" { consume-window-into-column; }
    Mod+H hotkey-overlay-title="Expel window from the group" { expel-window-from-column; }
 
    // Workspace navigation
    Mod+Ctrl+Up hotkey-overlay-title="Next workspace" { focus-workspace-up; }
    Mod+Ctrl+Down hotkey-overlay-title="Previous workspace" { focus-workspace-down; }

}
