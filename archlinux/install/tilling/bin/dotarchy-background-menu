#!/usr/bin/env bash

# Search for png files in all the ~/.config/themes/*/backgrounds/ directories
# Usage: dotarchy-background-menu

titles=("Nice choice!" "Great pick!" "Awesome selection!" "Perfect choice!" "Excellent taste!")
random_title=${titles[$RANDOM % ${#titles[@]}]}

hex_to_rgb() {
    local hex=${1#\#}
    local r=$((16#${hex:0:2}))
    local g=$((16#${hex:2:2}))
    local b=$((16#${hex:4:2}))
    echo "$r, $g, $b"
}


# Create the wallpapers directory if it doesn't exist
if [ ! -d ~/wallpapers ]; then
    mkdir -p ~/wallpapers

    # Notify the user that the ~/wallpapers can be populated with images
    notify-send "Wallpapers directory created" "You can add your wallpapers to the ~/wallpapers directory." -i info
fi

selected_file=$(find ~/.config/themes/*/backgrounds/ -type f \( -name "*.png" -o -name "*.jpg" -o -name "*.jpeg" \) | while read a; do echo -en "$a\0icon\x1f$a\n" ; done | rofi -dmenu -theme ~/.config/rofi/wall-select.rasi -p "Select a background")

# If no file was selected, exit
if [ -z "$selected_file" ]; then
    echo "No file selected!"
    exit 1
fi

# If the file is in the ~/.config/themes/*/backgrounds/ directories, extract the theme name
if [[ "$selected_file" =~ ^$HOME/.config/themes/([^/]+)/backgrounds/ ]]; then
    theme_name="${BASH_REMATCH[1]}"

    # Symlink the selected background to the current_background in the theme
    ln -sf "$selected_file" "$HOME/.config/themes/$theme_name/backgrounds/current_background"

    random_title=${titles[$RANDOM % ${#titles[@]}]}
    notify-send "$random_title" "Applying theme: $theme_name" -i info

    dotarchy-theme-set "$theme_name"

    exit 0
else
    notify-send "Sorry!" "The selected file is not in a theme's backgrounds directory." -i error
    exit 1
fi