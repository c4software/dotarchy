# Key bindings for zsh
bindkey -e  # Emacs mode

# Arrow keys match what you've typed so far against your command history
bindkey "^[[A" history-search-backward
bindkey "^[[B" history-search-forward

# Completion settings
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' # Case insensitive
zstyle ':completion:*' menu select # Menu selection
zstyle ':completion:*' list-colors "${(@s.:.)LS_COLORS}" # Colored completion
zstyle ':completion:*' special-dirs true # Complete . and ..
zstyle ':completion:*' file-list all # Show file information
zstyle ':completion:*' accept-exact-dirs true # Don't complete already exact dirs

# Don't autocomplete hidden files unless the pattern explicitly begins with a dot
setopt GLOB_DOTS

# Immediately add a trailing slash when autocompleting symlinks to directories
setopt AUTO_PARAM_SLASH
