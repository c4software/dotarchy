#!/usr/bin/env bash
set -euo pipefail

ENDPOINT="${ENDPOINT:-http://bigchuck:8009}"
CONFIG="${CONFIG:-$HOME/.config/opencode/opencode.json}"
PROVIDER="${PROVIDER:-llamaswap}"

models=$(curl -sf --max-time 5 "$ENDPOINT/v1/models" \
  | jq -e '[.data[].id] | sort | map({(.): {name: .}}) | add')

# fichier absent -> on génère la config complète
if [[ ! -s "$CONFIG" ]]; then
  mkdir -p "$(dirname "$CONFIG")"
  echo '{"$schema":"https://opencode.ai/config.json"}' > "$CONFIG"
fi

tmp=$(mktemp "${CONFIG}.XXXXXX")
jq --argjson models "$models" --arg p "$PROVIDER" '
  .provider[$p].name    //= "llama-swap (Strix Halo)"
  | .provider[$p].npm     //= "@ai-sdk/openai-compatible"
  | .provider[$p].options.baseURL //= "http://100.64.0.4:8009/v1"
  | .provider[$p].models = $models
' "$CONFIG" > "$tmp"

mv -f "$tmp" "$CONFIG"
echo "$(jq -r --arg p "$PROVIDER" '.provider[$p].models | length' "$CONFIG") modèles écrits dans $CONFIG"
